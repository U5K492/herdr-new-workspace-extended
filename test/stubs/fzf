#!/usr/bin/env bash
set -euo pipefail

input="$(cat)"
count_file="$FZF_STUB_DIR/count"
n=$(($(cat "$count_file" 2>/dev/null || echo 0) + 1))
echo "$n" >"$count_file"
printf '%s\n' "$*" >>"$FZF_STUB_DIR/calls"
printf '%s\n' "$input" >"$FZF_STUB_DIR/input.$n"

line="$(sed -n "${n}p" "$FZF_STUB_DIR/queue")"
action="${line%%$'\t'*}"
value="${line#*$'\t'}"

case "$action" in
select)
  printf '%s\n' "$input" | awk -F'\t' -v key="$value" '$1 == key { print; found = 1 } END { exit !found }'
  ;;
type)
  printf '%s\n' "$value"
  exit 1
  ;;
accept)
  query=""
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "--query" ]; then
      query="$2"
    fi
    shift
  done
  printf '%s\n' "$query"
  exit 1
  ;;
cancel)
  exit 130
  ;;
fail)
  echo "unsupported key: $value" >&2
  exit 2
  ;;
*)
  echo "fzf stub: no response queued for call $n" >&2
  exit 2
  ;;
esac
