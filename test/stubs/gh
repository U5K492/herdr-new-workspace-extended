#!/usr/bin/env bash
set -euo pipefail

{
  printf '[%s]' "$@"
  printf '\n'
} >>"$GH_STUB_DIR/calls"

case "$1 $2" in
"issue list")
  cat "$GH_STUB_DIR/issues.json"
  ;;
"issue view")
  printf 'issue %s\n' "$3"
  ;;
"repo view")
  printf '{"defaultBranchRef":{"name":"%s"}}\n' "${GH_STUB_DEFAULT_BRANCH:-main}"
  ;;
*)
  echo "gh stub: unexpected call: $*" >&2
  exit 2
  ;;
esac
