#!/usr/bin/env bash
set -euo pipefail

{
  printf '[%s]' "$@"
  printf '\n'
} >>"$GH_STUB_DIR/calls"

if [ "${GH_STUB_FAIL:-}" = "$1 $2" ]; then
  echo "HTTP 401: Bad credentials (https://api.github.com/graphql)" >&2
  exit 1
fi

case "$1 $2" in
"api graphql")
  args=" $* "
  filter=.
  while [ "$#" -gt 0 ]; do
    if [ "$1" = --jq ]; then
      filter="$2"
    fi
    shift
  done
  {
    if [[ "$args" == *" endCursor="* ]]; then
      cat "$GH_STUB_DIR/issues-page-2.json"
    else
      cat "$GH_STUB_DIR/issues-page-1.json"
      if [[ "$args" == *" --paginate "* ]]; then
        cat "$GH_STUB_DIR/issues-page-2.json"
      fi
    fi
  } | jq -r "$filter"
  ;;
"api user")
  printf '%s\n' "${GH_STUB_LOGIN:-octocat}"
  ;;
"issue view")
  if [ "${4:-}" = --json ]; then
    jq --argjson number "$3" '.data.repository.issues.nodes[] | select(.number == $number) | {number, title}' "$GH_STUB_DIR"/issues-page-*.json
  else
    printf 'issue %s\n' "$3"
  fi
  ;;
"pr list")
  cat "$GH_STUB_DIR/prs.json"
  ;;
"pr view")
  printf 'pr %s\n' "$3"
  ;;
"repo view")
  printf '{"defaultBranchRef":{"name":"%s"}}\n' "${GH_STUB_DEFAULT_BRANCH:-main}"
  ;;
*)
  echo "gh stub: unexpected call: $*" >&2
  exit 2
  ;;
esac
