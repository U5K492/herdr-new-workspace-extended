#!/usr/bin/env bash
set -euo pipefail

{
  printf '[%s]' "$@"
  printf '\n'
} >>"$GH_STUB_DIR/calls"

if [ "${GH_STUB_FAIL:-}" = "$1 $2" ]; then
  echo "HTTP 401: Bad credentials (https://api.github.com/graphql)" >&2
  exit 1
fi

case "$1 $2" in
"issue list")
  cat "$GH_STUB_DIR/issues.json"
  ;;
"issue view")
  printf 'issue %s\n' "$3"
  ;;
"pr list")
  cat "$GH_STUB_DIR/prs.json"
  ;;
"pr view")
  printf 'pr %s\n' "$3"
  ;;
"repo view")
  printf '{"defaultBranchRef":{"name":"%s"}}\n' "${GH_STUB_DEFAULT_BRANCH:-main}"
  ;;
*)
  echo "gh stub: unexpected call: $*" >&2
  exit 2
  ;;
esac
